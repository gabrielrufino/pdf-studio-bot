{
  "name": "@gabrielrufino/pdf-studio-bot",
  "version": "2.1.2",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "author": "Gabriel Rufino <contato@gabrielrufino.com>",
  "license": "UNLICENSED",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "tsdown src/index.ts --format cjs",
    "build:check": "tsc --noEmit",
    "build:watch": "tsdown src/index.ts --watch",
    "lint": "eslint ./src",
    "lint:fix": "pnpm run lint --fix",
    "start": "node .",
    "start:dev": "tsx watch --env-file=.env src/index.ts",
    "test": "vitest run",
    "test:cov": "pnpm run test --coverage",
    "test:watch": "vitest",
    "test:mutate": "stryker run",
    "prepare": "if [ \"$NODE_ENV\" != \"production\" ]; then husky; fi"
  },
  "dependencies": {
    "@grammyjs/files": "1.2.0",
    "@grammyjs/ratelimiter": "1.2.1",
    "@grammyjs/runner": "2.0.3",
    "@grammyjs/storage-mongodb": "2.6.0",
    "grammy": "1.46.0",
    "ipaddr.js": "^2.5.0",
    "mongodb": "7.7.0",
    "muhammara": "5.4.0",
    "node-cron": "4.6.0",
    "pdf-lib": "1.17.1",
    "pdf-parse": "2.4.5",
    "pdf-to-img": "7.0.1",
    "pino": "10.4.0",
    "puppeteer": "25.16.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@faker-js/faker": "10.6.0",
    "@gabrielrufino/types": "1.2.1",
    "@mapbox/node-pre-gyp": "2.0.3",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "1.1.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "tsdown": "0.23.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
